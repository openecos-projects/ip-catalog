# Large archives and downloaded sources
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
downloads/
third_party_src/

# Child repository working copies may be staged as templates, but never include nested git metadata.
child-repos/**/.git/

# Keep repository-owned generated indexes trackable.
!generated/
!generated/.gitkeep
!generated/**/*.json
!generated/**/*.md
